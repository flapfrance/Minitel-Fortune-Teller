[Unit]
Description=Minitel Fortune Teller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=seb
WorkingDirectory=/home/seb/projects/minitel/Fortune2
EnvironmentFile=-/etc/minitel-fortune.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/seb/projects/minitel/Fortune2/.venv/bin/python /home/seb/projects/minitel/Fortune2/fortune80qr.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
