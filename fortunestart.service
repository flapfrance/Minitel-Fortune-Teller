[Unit]
Description=Minitel Fortune Teller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@APP_USER@
WorkingDirectory=@APP_DIR@
EnvironmentFile=-/etc/minitel-fortune.env
Environment=PYTHONUNBUFFERED=1
ExecStart="@APP_DIR@/.venv/bin/python" "@APP_DIR@/fortune80qr.py"
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
